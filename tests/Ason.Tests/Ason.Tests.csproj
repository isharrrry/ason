<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One leg per runtime the libraries admit. Microsoft.AspNetCore.Mvc.Testing used to be referenced here and
         was the reason this suite stayed on net9.0 - it ships a net8.0 asset only - but nothing in the repository
         ever used it (no WebApplicationFactory anywhere), so the unused reference is gone and the oldest
         supported host is covered. -->
    <TargetFrameworks>net6.0;net9.0;net10.0</TargetFrameworks>
    <!-- The net6.0 leg would otherwise compile as C# 10 (its default) while the sources use C# 12 syntax such as
         primary constructors (CS8936); the compiler is the SDK's, so the language level is a project choice. -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>..\bin</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.3" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.45.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" Version="1.45.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ason.ExternalExecutor\Ason.ExternalExecutor.csproj" />
    <ProjectReference Include="..\..\src\Ason.RemoteBridge\Ason.RemoteBridge.csproj" />
    <ProjectReference Include="..\..\src\Ason\Ason.csproj" />
  </ItemGroup>
</Project>
