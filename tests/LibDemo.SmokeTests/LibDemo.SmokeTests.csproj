<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net6.0/net10.0 also run the assertions on those runtimes, so the ASON assets are
         exercised for real instead of only being compiled. net472 is the certificate leg for the
         netstandard2.0 asset: it is the only way to actually *run* what a .NET Framework host gets. -->
    <TargetFrameworks>net6.0;net9.0;net10.0;net472</TargetFrameworks>
    <!-- net472 defaults to C# 7.3, and these tests use file-scoped namespaces and implicit usings. -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>..\bin</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- The .NET Framework 4.7.2 targeting pack is not part of the SDK; this package supplies it from NuGet. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\LibDemo\LibDemo.csproj" />
    <ProjectReference Include="..\..\src\Ason\Ason.csproj" />
  </ItemGroup>

</Project>
