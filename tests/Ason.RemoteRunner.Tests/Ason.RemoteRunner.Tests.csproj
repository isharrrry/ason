<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One leg per runtime the libraries admit; the integration test itself is skipped unless
         ASON_REMOTE_RUNNER_URL points at a running remote runner. -->
    <TargetFrameworks>net6.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.45.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" Version="1.45.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nothing here references src/Ason.Runner: that project was renamed to Ason.Runner.Core in an earlier wave
         and the namespace AsonRunner moved with it, but the stale ProjectReference stayed behind. MSBuild reports
         a missing project as the *warning* MSB9008, so this suite kept building - and staying green - against a
         reference that resolved to nothing. BuildMatrixTests now fails on any dangling ProjectReference. -->
    <ProjectReference Include="..\..\src\Ason\Ason.csproj" />
  </ItemGroup>

</Project>
