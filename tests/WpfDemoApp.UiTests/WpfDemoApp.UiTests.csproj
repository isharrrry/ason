<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>..\bin</BaseOutputPath>
    <!-- These tests drive a real desktop window through UI Automation, so they only run in an
         interactive Windows session (not in a headless CI agent). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Guarantees the sample is built; WPF_DEMO_TFM selects which leg the tests launch. -->
    <ProjectReference Include="..\..\samples\WptDemoApp\WpfSampleApp.csproj" />
  </ItemGroup>

</Project>
