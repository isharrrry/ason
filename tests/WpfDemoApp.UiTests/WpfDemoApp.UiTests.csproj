<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One leg per Windows runtime the demo application ships, so UI Automation can drive any of them:
         WPF_DEMO_TFM picks the sample build the tests launch, and it defaults to net9.0-windows. FlaUI.UIA3
         5.0.0 carries a net6.0-windows7.0 asset, so the oldest leg is covered too. -->
    <TargetFrameworks>net6.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>..\bin</BaseOutputPath>
    <!-- These tests drive a real desktop window through UI Automation, so they only run in an
         interactive Windows session (not in a headless CI agent). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Guarantees the sample is built; WPF_DEMO_TFM selects which leg the tests launch. -->
    <ProjectReference Include="..\..\samples\WptDemoApp\WpfSampleApp.csproj" />
  </ItemGroup>

</Project>
