<Window x:Class="WpfAppOnlyDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASON application (no agent)" Height="640" Width="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="ASON application" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="This application contains only [Ason*] operators. There is no model and no chat here: an agent connects over gRPC or MCP to read the operator API and to execute scripts or single functions." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,12" Orientation="Horizontal">
            <TextBlock Text="gRPC" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="GrpcUrlText" Margin="8,0,24,0" VerticalAlignment="Center" />
            <TextBlock Text="MCP" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="McpUrlText" Margin="8,0,24,0" VerticalAlignment="Center" />
            <Button x:Name="CopyButton" Content="Copy endpoints" Padding="10,4" Click="OnCopyEndpoints" />
        </StackPanel>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="Employees (operator-owned state, bound to the UI)"
                       FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListView x:Name="EmployeesList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" Width="60" DisplayMemberBinding="{Binding Id}" />
                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Department" Width="180" DisplayMemberBinding="{Binding Department}" />
                        <GridViewColumn Header="Hired" Width="140" DisplayMemberBinding="{Binding Hired}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Bridge activity" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListView x:Name="ActivityList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Log" Width="940" DisplayMemberBinding="{Binding}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</Window>
