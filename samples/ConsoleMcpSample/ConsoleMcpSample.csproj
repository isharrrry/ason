<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The only dependency is Ason (a single netstandard2.0 asset), so the net6.0 floor costs nothing here: this
         is an agent-side sample a legacy host can also run. -->
    <TargetFrameworks>net6.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ason\Ason.csproj" />
  </ItemGroup>
</Project>
