<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Ason.ProjectTemplates</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>ASON Project Templates</Title>
    <Authors>Alexgoon</Authors>
    <Description>ASON templates for Blazor, WPF, WinFormsm and MAUI</Description>
    <PackageTags>dotnet-new;templates;AI;Ason;Blazor;WPF;WinForms;MAUI</PackageTags>
    <PackageType>Template</PackageType>
    <!-- The pack project follows the two runtime tiers the templates scaffold. What it *is* does not depend on
         the TFM (it ships content), but leaving it on the older tier is how a package ends up disagreeing with
         everything it contains. `dotnet pack` writes the same nupkg once per tier; the content is identical. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <!-- This project only packs template content. Without this the SDK compiles Content/**/*.cs as
         part of this project, which fails (multiple top-level statements, missing template deps). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	<PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="*" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Content\**\*" Exclude="content\**\bin\**;content\**\obj\**;content\**\.vs\**;content\**\*.user;content\**\*.suo" Pack="true" PackagePath="content" />
	<None Include="icon.png" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>