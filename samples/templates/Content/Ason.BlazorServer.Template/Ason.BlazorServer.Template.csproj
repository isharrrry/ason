<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Scaffolds the two runtime tiers this repository ships for applications; the published packages' net9.0
         assets are what the net10.0 leg consumes (NuGet's nearest-compatible rule). -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ason" Version="*" />
    <PackageReference Include="Ason.ExternalExecutor" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Model\" />
  </ItemGroup>

</Project>
