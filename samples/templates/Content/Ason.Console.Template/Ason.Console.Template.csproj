<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Scaffolds the two runtime tiers this repository ships for applications. The published Ason package's
         net9.0 asset is what the net10.0 leg consumes (NuGet's nearest-compatible rule), so both legs build
         against the same library. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ason" Version="*" />
  </ItemGroup>

</Project>
