<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The agent side. It declares no [AsonOperator] at all: it reads the application's operator API from the
       bridge and asks the application to execute. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ason\Ason.csproj" />
    <ProjectReference Include="..\..\src\Ason.Bridge\Ason.Bridge.csproj" />
    <ProjectReference Include="..\..\src\Ason.Bridge.Grpc\Ason.Bridge.Grpc.csproj" />
    <ProjectReference Include="..\..\src\Ason.Bridge.Mcp\Ason.Bridge.Mcp.csproj" />
  </ItemGroup>

</Project>
