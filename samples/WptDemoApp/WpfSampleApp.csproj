<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net9.0-windows;net6.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<XamlDebuggingInformation>True</XamlDebuggingInformation>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appIcon.png" />
    <None Remove="Images\send.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\appIcon.png" />
    <Resource Include="Images\send.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="ScottPlot.WPF" Version="5.0.56" />
    <PackageReference Include="ModelContextProtocol.Core" Version="0.4.0-preview.3" />
    <!-- net9.0-windows and net10.0-windows get the platform Fluent theme through ThemeMode; net6.0-windows
         has no ThemeMode at all (it is a .NET 9 API), so the demo brings the Fluent look with it. Both looks
         are Fluent, and this keeps the net6 build from falling back to the classic Aero2 theme. -->
    <PackageReference Include="WPF-UI" Version="3.1.1" Condition="'$(TargetFramework)' == 'net6.0-windows'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ason\Ason.csproj" />
    <ProjectReference Include="..\LibDemo\LibDemo.csproj" />
  </ItemGroup>

</Project>
