<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>..\bin</BaseOutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Authors>Alexgoon</Authors>
    <PackageId>Ason.Bridge</PackageId>
    <Description>Exposes an ASON application's operator API to agents over pluggable service adapters (gRPC, MCP, OpenAPI) and forwards execution requests to an internal or external executor.</Description>
    <RepositoryUrl>https://github.com/Alexgoon/ason</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- Microsoft.Extensions.* abstractions (DI, logging) arrive transitively through Ason; referencing them
       explicitly here would pin a lower version than ModelContextProtocol.Core requires (NU1605). -->
  <ItemGroup>
    <ProjectReference Include="..\Ason\Ason.csproj" />
    <ProjectReference Include="..\Ason.Runner.Core\Ason.Runner.Core.csproj" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
