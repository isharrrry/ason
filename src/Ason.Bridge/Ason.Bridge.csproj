<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Wave 3: net6.0/net9.0/net10.0, *not* netstandard2.0. Two reasons, both verified: the core uses default
         interface members (IAsonExecutor.McpServers, IAsonBridgeEndpoint.ExecuteScriptWithLogsAsync), which
         netstandard2.0 cannot compile (CS8701); and nothing would consume a netstandard2.0 bridge anyway - every
         adapter needs the ASP.NET Core shared framework, so a legacy .NET Framework host can only embed the
         scripting engine (Ason.Runner.Core + Ason), which is where the ns2.0 asset actually belongs. -->
    <TargetFrameworks>net6.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>..\bin</BaseOutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Authors>Alexgoon</Authors>
    <PackageId>Ason.Bridge</PackageId>
    <Description>Exposes an ASON application's operator API to agents over pluggable service adapters (gRPC, MCP, OpenAPI) and forwards execution requests to an internal or external executor.</Description>
    <RepositoryUrl>https://github.com/Alexgoon/ason</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- Microsoft.Extensions.* abstractions (DI, logging) arrive transitively through Ason; referencing them
       explicitly here would pin a lower version than ModelContextProtocol.Core requires (NU1605). -->
  <ItemGroup>
    <ProjectReference Include="..\Ason\Ason.csproj" />
    <ProjectReference Include="..\Ason.Runner.Core\Ason.Runner.Core.csproj" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
