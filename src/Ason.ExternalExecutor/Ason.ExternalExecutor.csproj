<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<BaseOutputPath>..\bin</BaseOutputPath>
		<OutputType>Exe</OutputType>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<Authors>Alexgoon</Authors>
		<PackageId>Ason.ExternalExecutor</PackageId>
		<Description>External executable host process for ASON script execution (invoked out-of-process or in Docker).</Description>
		<RepositoryUrl>https://github.com/Alexgoon/ason</RepositoryUrl>
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateRuntimeConfigFile>true</GenerateRuntimeConfigFile>
		<GenerateDepsFile>true</GenerateDepsFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
		<!-- Matches Ason.Runner.Core and what the MCP preview package requires: see the note there. A lower pin
		     makes this project copy an older assembly into the shared output folder over the newer one. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10" />
	</ItemGroup>

	<!-- Host manifest files (runtimeconfig/deps) travel per target framework: a multi-targeted executable has one
	     pair per framework, and a consuming project must get the pair matching its own framework. They are
	     collected in a target so the list follows $(TargetFrameworks) automatically; evaluating $(OutputPath) at
	     evaluation time is empty in the outer build, which is what used to fail with NU5019. -->
	<Target Name="AsonExternalExecutor_CollectHostFiles" BeforeTargets="_GetPackageFiles">
		<ItemGroup>
			<None Include="$(BaseOutputPath)$(Configuration)\%(AsonExecutorTfm.Identity)\$(AssemblyName).runtimeconfig.json"
			      Pack="true" PackagePath="buildTransitive/host/%(AsonExecutorTfm.Identity)/" />
			<None Include="$(BaseOutputPath)$(Configuration)\%(AsonExecutorTfm.Identity)\$(AssemblyName).deps.json"
			      Pack="true" PackagePath="buildTransitive/host/%(AsonExecutorTfm.Identity)/" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<!-- One item per framework; the target above batches over them. -->
		<AsonExecutorTfm Include="$(TargetFrameworks)" />
		<!-- Explicitly include the targets file in the nupkg (SDK does not auto-include arbitrary buildTransitive files inside project dir unless marked) -->
		<None Include="buildTransitive/Ason.ExternalExecutor.targets" Pack="true" PackagePath="buildTransitive/" />
		<None Include="icon.png" Pack="true" PackagePath="\"/>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Protocol\" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="Ason.Runner.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Ason.Runner.Core\Ason.Runner.Core.csproj" />
	</ItemGroup>

</Project>