<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Wave 3: one asset only - the netstandard2.0 build is what .NET Framework 4.6.2+ and every modern .NET
         host consume. Keeping net6.0/net9.0 legs as well would add build and test surface, not consumers. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	<BaseOutputPath>..\bin</BaseOutputPath>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<IsPackable>true</IsPackable>
	<Authors>Alexgoon</Authors>
	<PackageId>Ason.Runner.Core</PackageId>
	<Description>A core ASON part responsible for executing generated scripts.</Description>
	<RepositoryUrl>https://github.com/Alexgoon/ason</RepositoryUrl>
	<PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
    <!-- The same version the MCP preview package already requires on net9.0 (ModelContextProtocol.Core 0.4.0
         pulls 9.0.10), instead of a lower 8.0.0 floor. Two versions of one assembly in the output folder every
         project shares (BaseOutputPath=..\bin) is not a floor, it is a race: this project copied 8.0.0 over the
         9.0.10 next to the stdio relay, and the relay child process then died on Linux with exit 134. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10" />
    <!-- netstandard2.0 has no in-box System.Text.Json (it is part of the framework from .NET 5 on), so it has
         to be referenced here. Version matches what the rest of the graph resolves, to avoid NU1605. -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
