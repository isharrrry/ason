<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>..\bin</BaseOutputPath>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Authors>Alexgoon</Authors>
    <PackageId>Ason.Bridge.Grpc</PackageId>
    <Description>gRPC adapter for Ason.Bridge: an application exposes its operator API and executes scripts or single functions for an agent over gRPC.</Description>
    <RepositoryUrl>https://github.com/Alexgoon/ason</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.71.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\ason_bridge.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ason.Bridge\Ason.Bridge.csproj" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
    <!-- A non-.NET caller needs the contract itself, so it ships with the package: unpack it, or locate it
         with GeneratePathProperty ($(PkgAson_Bridge_Grpc))\protos\ason_bridge.proto. Paths are written with
         forward slashes because a backslash is not a directory separator outside Windows; the sibling
         project that ships buildTransitive/Ason.ExternalExecutor.targets already does it this way. -->
    <None Include="Protos/ason_bridge.proto" Pack="true" PackagePath="protos/" />
  </ItemGroup>

</Project>
